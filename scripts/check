#!/usr/bin/env bash
# Single entry point for the project's gates: scripts/check <gate> [...]
# Gates: lint, test, lock, leak, fuzz, audit, secrets, workflows, all. Add a gate by appending a case branch.
set -euo pipefail

export UV_PYTHON_DOWNLOADS=never

SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="${CUI_GUARD_ROOT:-$SELF_ROOT}"

# Tools come from the repo venv when present, otherwise from PATH.
tool() {
  local name="$1"
  if [ -x "$SELF_ROOT/.venv/bin/$name" ]; then
    printf '%s\n' "$SELF_ROOT/.venv/bin/$name"
  else
    command -v "$name" || { echo "missing tool: $name" >&2; return 1; }
  fi
}

# Drop the autogenerated header (it embeds the output path) before comparing.
strip_header() { grep -v -e '^# This file was autogenerated' -e '^#    uv export' "$1"; }

gate_lint() { (cd "$ROOT" && "$(tool ruff)" check .); }
gate_test() { (cd "$ROOT" && "$(tool pytest)" -q); }
gate_leak() { (cd "$ROOT" && "$(tool pytest)" -q tests/leak tests/pentest tests/redteam); }
# HYPOTHESIS_PROFILE (ci or nightly) passes through to the fuzz properties; default ci.
gate_fuzz() { (cd "$ROOT" && HYPOTHESIS_PROFILE="${HYPOTHESIS_PROFILE:-ci}" "$(tool pytest)" -q tests/fuzz); }
gate_lock() {
  local uv tmp rc=0
  uv="$(tool uv)"
  tmp="$(mktemp -d)"
  if ! (cd "$ROOT" && "$uv" lock --check); then
    echo "lock drift: run 'uv lock' and re-export (see scripts/check)" >&2
    return 1
  fi
  (cd "$ROOT" &&
    "$uv" export --frozen --no-dev --no-emit-project --format requirements-txt -o "$tmp/runtime.lock.txt" &&
    "$uv" export --frozen --only-group dev --no-emit-project --format requirements-txt -o "$tmp/dev.lock.txt") >/dev/null
  for f in runtime.lock.txt dev.lock.txt; do
    if ! diff <(strip_header "$tmp/$f") <(strip_header "$ROOT/requirements/$f") >&2; then
      rc=1
    fi
  done
  rm -rf "$tmp"
  if [ "$rc" -ne 0 ]; then
    echo "lock drift: run 'uv lock' and re-export (see scripts/check)" >&2
  fi
  return "$rc"
}

# Prints one gate's skip reason and returns 3 so run_gate reports SKIPPED.
SKIP_RC=3

# pip-audit does not declare support for Python 3.15 or newer; run it on 3.12
# (never downloaded) when the venv interpreter is that new.
pip_audit() {
  local py minor
  py="$SELF_ROOT/.venv/bin/python"
  minor="$("$py" -c 'import sys; print(sys.version_info[0] * 100 + sys.version_info[1])' 2>/dev/null || echo 0)"
  if [ "$minor" -ge 315 ]; then
    "$(tool uv)" tool run --python 3.12 pip-audit "$@"
  else
    "$(tool pip-audit)" "$@"
  fi
}

# Every lock file is audited against both advisory sources (one unfiltered JSON run each).
# vex.py check fails on any finding not triaged in security/vex.cdx.json (matching
# --ignore-vuln semantics: ID or alias), on an unreadable result, and on expired,
# over-long, incomplete or stale (matches no finding) VEX entries.
gate_audit() {
  local tmp f src out=() rc=0
  tmp="$(mktemp -d)"
  for f in runtime dev; do
    for src in pypi osv; do
      # pip-audit exits 1 when it finds something; vex.py judges the JSON, and a run
      # that produced no valid JSON fails closed there.
      pip_audit --strict --require-hashes -s "$src" -f json \
        -r "$ROOT/requirements/$f.lock.txt" >"$tmp/$f-$src.json" || true
      out+=("$tmp/$f-$src.json")
    done
  done
  "$(tool python)" "$ROOT/scripts/security/vex.py" check "${out[@]}" || rc=$?
  rm -rf "$tmp"
  return "$rc"
}
gate_secrets() {
  command -v gitleaks >/dev/null 2>&1 || { SKIP_REASON="gitleaks not installed; runs in CI"; return "$SKIP_RC"; }
  (cd "$ROOT" && gitleaks git --redact --config .gitleaks.toml)
}
gate_workflows() {
  [ -d "$ROOT/.github/workflows" ] || { SKIP_REASON="no workflows yet"; return "$SKIP_RC"; }
  (cd "$ROOT" && "$(tool zizmor)" --config .github/zizmor.yml .github/workflows)
}

run_gate() {
  local gate="$1" rc=0
  case "$gate" in
    lint) gate_lint || rc=$? ;;
    test) gate_test || rc=$? ;;
    lock) gate_lock || rc=$? ;;
    leak) gate_leak || rc=$? ;;
    fuzz) gate_fuzz || rc=$? ;;
    audit) gate_audit || rc=$? ;;
    secrets) gate_secrets || rc=$? ;;
    workflows) gate_workflows || rc=$? ;;
    *) echo "unknown gate: $gate (known: lint test lock leak fuzz audit secrets workflows all)" >&2; return 2 ;;
  esac
  if [ "$rc" -eq "$SKIP_RC" ]; then
    echo "== $gate: SKIPPED (${SKIP_REASON:-skipped})"
    return 0
  elif [ "$rc" -eq 0 ]; then
    echo "== $gate: PASS"
  else
    echo "== $gate: FAIL"
  fi
  return "$rc"
}

[ "$#" -ge 1 ] || { echo "usage: scripts/check <gate> [...]  (lint test lock leak fuzz audit secrets workflows all)" >&2; exit 2; }

failed=0
for arg in "$@"; do
  if [ "$arg" = "all" ]; then
    for g in lint test lock audit secrets workflows; do
      run_gate "$g" || failed=1
    done
  else
    run_gate "$arg" || exit $?
  fi
done
exit "$failed"
