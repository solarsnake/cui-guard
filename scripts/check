#!/usr/bin/env bash
# Single entry point for the project's gates: scripts/check <gate> [...]
# Gates: lint, test, perf, lock, leak, fuzz, audit, secrets, workflows, sbom, build, fips, all, report. Add a gate by appending a case branch.
# `all` leaves out fips: it needs Docker (CI runs it in its own job; `report` includes it).
# `test` leaves out absolute-latency tests (`@pytest.mark.perf`); the `perf` gate runs only those.
# CUI_GUARD_STRICT=1 (set for every CI job, nightly and the release) makes a SKIPPED gate a FAIL.
set -euo pipefail

export UV_PYTHON_DOWNLOADS=never

SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="${CUI_GUARD_ROOT:-$SELF_ROOT}"

# Tools come from the repo venv when present, otherwise from PATH.
tool() {
  local name="$1"
  if [ -x "$SELF_ROOT/.venv/bin/$name" ]; then
    printf '%s\n' "$SELF_ROOT/.venv/bin/$name"
  else
    command -v "$name" || { echo "missing tool: $name" >&2; return 1; }
  fi
}

# uv.lock (a hash for every artifact) is the single source of truth. The hash-pinned
# requirements files are generated into build/locks/ and never committed.
export_locks() {
  local uv
  uv="$(tool uv)" || return 1
  mkdir -p "$ROOT/build/locks"
  (cd "$ROOT" &&
    "$uv" export --frozen --no-dev --no-emit-project --format requirements-txt -o build/locks/runtime.lock.txt &&
    "$uv" export --frozen --only-group dev --no-emit-project --format requirements-txt -o build/locks/dev.lock.txt) >/dev/null
}

gate_lint() { (cd "$ROOT" && "$(tool ruff)" check .); }
# REPORT_RAW (set by the report gate) is the dir that collects machine output; unset, nothing is written.
junit() { if [ -n "${REPORT_RAW:-}" ]; then printf '%s\n' "--junitxml=$REPORT_RAW/$1.xml"; fi; }
gate_test() { (cd "$ROOT" && "$(tool pytest)" -q -m "not perf" $(junit test)); }
gate_perf() { (cd "$ROOT" && "$(tool pytest)" -q -m perf $(junit perf)); }
gate_leak() { (cd "$ROOT" && "$(tool pytest)" -q $(junit leak) tests/leak tests/pentest tests/redteam); }
# HYPOTHESIS_PROFILE (ci or nightly) passes through to the fuzz properties; default ci.
gate_fuzz() { (cd "$ROOT" && HYPOTHESIS_PROFILE="${HYPOTHESIS_PROFILE:-ci}" "$(tool pytest)" -q $(junit fuzz) tests/fuzz); }
gate_lock() {
  local uv f hint="lock drift: run 'uv lock' (see scripts/check)"
  uv="$(tool uv)" || return 1
  if ! (cd "$ROOT" && "$uv" lock --check); then
    echo "$hint" >&2
    return 1
  fi
  if ! export_locks; then
    echo "$hint" >&2
    return 1
  fi
  # Every pinned requirement must carry at least one hash.
  for f in runtime dev; do
    if ! "$(tool python)" - "$ROOT/build/locks/$f.lock.txt" <<'PY'
import re
import sys

blocks = re.split(r"\n(?=\S)", open(sys.argv[1], encoding="utf-8").read())
bad = [b.split()[0] for b in blocks if re.match(r"[A-Za-z0-9][^=\s]*==", b) and "--hash=sha256:" not in b]
if bad:
    sys.exit(f"unhashed requirements: {bad}")
PY
    then
      echo "$hint" >&2
      return 1
    fi
  done
}

# Prints one gate's skip reason and returns 3 so run_gate reports SKIPPED.
SKIP_RC=3

# pip-audit does not declare support for Python 3.15 or newer; run it on 3.12
# (never downloaded) when the venv interpreter is that new.
pip_audit() {
  local py minor
  py="$SELF_ROOT/.venv/bin/python"
  minor="$("$py" -c 'import sys; print(sys.version_info[0] * 100 + sys.version_info[1])' 2>/dev/null || echo 0)"
  if [ "$minor" -ge 315 ]; then
    "$(tool uv)" tool run --python 3.12 pip-audit "$@"
  else
    "$(tool pip-audit)" "$@"
  fi
}

# Every lock file is audited against both advisory sources (one unfiltered JSON run each).
# vex.py check fails on any finding not triaged in security/vex.cdx.json (matching
# --ignore-vuln semantics: ID or alias), on an unreadable result, and on expired,
# over-long, incomplete or stale (matches no finding) VEX entries.
gate_audit() {
  local tmp f src out=() rc=0
  export_locks || return 1
  if [ -n "${REPORT_RAW:-}" ]; then tmp="$REPORT_RAW"; else tmp="$(mktemp -d)"; fi
  for f in runtime dev; do
    for src in pypi osv; do
      # pip-audit exits 1 when it finds something; vex.py judges the JSON, and a run
      # that produced no valid JSON fails closed there.
      pip_audit --strict --require-hashes -s "$src" -f json \
        -r "$ROOT/build/locks/$f.lock.txt" >"$tmp/audit-$f-$src.json" || true
      out+=("$tmp/audit-$f-$src.json")
    done
  done
  "$(tool python)" "$ROOT/scripts/security/vex.py" check "${out[@]}" || rc=$?
  if [ -z "${REPORT_RAW:-}" ]; then rm -rf "$tmp"; fi
  return "$rc"
}
# GITLEAKS_BIN, when set, is the gitleaks binary to run (a missing one fails, it does not skip).
gate_secrets() {
  local gl="${GITLEAKS_BIN:-}"
  if [ -z "$gl" ]; then
    gl="$(command -v gitleaks)" || { SKIP_REASON="gitleaks not installed; runs in CI"; return "$SKIP_RC"; }
  fi
  (cd "$ROOT" && "$gl" git --redact --config .gitleaks.toml)
}
gate_workflows() {
  [ -d "$ROOT/.github/workflows" ] || { SKIP_REASON="no workflows yet"; return "$SKIP_RC"; }
  (cd "$ROOT" && "$(tool zizmor)" --config .github/zizmor.yml .github/workflows)
}

# SBOM of the runtime lock, checked against the minimum elements. Written to build/sbom/
# because the wheel embeds that exact path (pyproject sbom-files).
gate_sbom() {
  local py
  py="$(tool python)"
  export_locks || return 1
  (cd "$ROOT" && "$py" scripts/security/sbom.py build --out build/sbom/cui-guard.cdx.json &&
    "$py" scripts/security/sbom.py check build/sbom/cui-guard.cdx.json) || return 1
  if [ -n "${REPORT_RAW:-}" ]; then
    "$py" -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' \
      "$ROOT/build/sbom/cui-guard.cdx.json" >"$REPORT_RAW/sbom.sha256"
  fi
}

# Build the SBOM, then run `uv build` twice into fresh directories with a fixed
# SOURCE_DATE_EPOCH (HEAD commit time); the wheel must embed the SBOM and every artifact must have an identical SHA-256.
gate_build() {
  local uv py epoch f listing rc=0
  uv="$(tool uv)" || return 1
  py="$(tool python)"
  epoch="$(git -C "$ROOT" log -1 --format=%ct)" || return 1
  export SOURCE_DATE_EPOCH="$epoch"
  export_locks || return 1
  gate_sbom >/dev/null || return 1
  rm -rf "$ROOT/build/dist-a" "$ROOT/build/dist-b"
  if [ -n "${REPORT_RAW:-}" ]; then : >"$REPORT_RAW/build-a.digests"; : >"$REPORT_RAW/build-b.digests"; fi
  # Standard flow: SBOM first, then sdist and the wheel built from it.
  (cd "$ROOT" && for d in a b; do "$uv" build --out-dir "build/dist-$d"; done) >/dev/null || return 1
  for d in a b; do
    # Capture first: grep -q closing the pipe early would trip pipefail.
    listing="$(unzip -l "$ROOT"/build/dist-$d/*.whl)"
    case "$listing" in
      *.dist-info/sboms/cui-guard.cdx.json*) ;;
      *) echo "wheel in dist-$d lacks the embedded SBOM" >&2; return 1 ;;
    esac
  done
  [ -n "$(ls "$ROOT/build/dist-a")" ] || { echo "no artifacts built" >&2; return 1; }
  [ "$(ls "$ROOT/build/dist-a")" = "$(ls "$ROOT/build/dist-b")" ] || { echo "artifact names differ" >&2; return 1; }
  for f in $(ls "$ROOT/build/dist-a"); do
    local a b
    a="$("$py" -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$ROOT/build/dist-a/$f")"
    b="$("$py" -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$ROOT/build/dist-b/$f")"
    if [ -n "${REPORT_RAW:-}" ]; then
      echo "$a  $f" >>"$REPORT_RAW/build-a.digests"
      echo "$b  $f" >>"$REPORT_RAW/build-b.digests"
    fi
    if [ "$a" = "$b" ]; then
      echo "$a  $f"
    else
      echo "DIFFERENT $f: $a != $b" >&2
      rc=1
    fi
  done
  return "$rc"
}

# FIPS provider checks and a TLS handshake inside Red Hat UBI 9 with the OpenSSL FIPS
# provider forced on (design 8.3). Needs a working Docker daemon, not just the CLI.
gate_fips() {
  if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
    SKIP_REASON="docker not available"
    return "$SKIP_RC"
  fi
  export_locks || return 1
  "$ROOT/tests/fips/run_in_ubi9.sh"
}

# Every gate, continuing past failures, with machine output kept in build/security-report/raw
# (status and duration per gate), then report.py renders summary.md and report.json.
LAST_STATUS=""
gate_report() {
  local out="$ROOT/build/security-report" g start py st rest
  export REPORT_RAW="$out/raw"
  py="$(tool python)"
  rm -rf "$out"
  mkdir -p "$REPORT_RAW"
  export_locks
  {
    echo "python $("$py" -c 'import platform; print(platform.python_version())')"
    echo "uv $("$(tool uv)" --version | cut -d' ' -f2)"
    echo "ruff $("$(tool ruff)" --version | cut -d' ' -f2)"
    echo "pytest $("$(tool pytest)" --version 2>&1 | cut -d' ' -f2)"
  } >"$REPORT_RAW/tools.txt"
  for g in lint lock test perf leak fuzz audit secrets workflows sbom build fips; do
    start=$SECONDS
    run_gate "$g" || true
    st="${LAST_STATUS%% *}"
    rest=""
    [ "$st" = "SKIPPED" ] && rest=" ${LAST_STATUS#SKIPPED }"
    echo "$st $((SECONDS - start))$rest" >"$REPORT_RAW/$g.status"
  done
  "$py" "$ROOT/scripts/security/report.py" render --raw "$REPORT_RAW" --out "$out"
}

run_gate() {
  local gate="$1" rc=0
  SKIP_REASON=""
  case "$gate" in
    lint) gate_lint || rc=$? ;;
    test) gate_test || rc=$? ;;
    perf) gate_perf || rc=$? ;;
    lock) gate_lock || rc=$? ;;
    leak) gate_leak || rc=$? ;;
    fuzz) gate_fuzz || rc=$? ;;
    audit) gate_audit || rc=$? ;;
    secrets) gate_secrets || rc=$? ;;
    workflows) gate_workflows || rc=$? ;;
    sbom) gate_sbom || rc=$? ;;
    build) gate_build || rc=$? ;;
    fips) gate_fips || rc=$? ;;
    *) echo "unknown gate: $gate (known: lint test perf lock leak fuzz audit secrets workflows sbom build fips all report)" >&2; return 2 ;;
  esac
  # Exit 3 is a skip only when the gate said why; pytest also exits 3 on an
  # internal error, and that must never read as a skip.
  if [ "$rc" -eq "$SKIP_RC" ] && [ -z "$SKIP_REASON" ]; then
    LAST_STATUS="FAIL"
    echo "== $gate: FAIL (exit $rc without a skip reason)"
    return 1
  elif [ "$rc" -eq "$SKIP_RC" ] && [ "${CUI_GUARD_STRICT:-}" = "1" ]; then
    LAST_STATUS="FAIL"
    echo "== $gate: FAIL (skipped in strict mode: ${SKIP_REASON})"
    return 1
  elif [ "$rc" -eq "$SKIP_RC" ]; then
    LAST_STATUS="SKIPPED ${SKIP_REASON}"
    echo "== $gate: SKIPPED (${SKIP_REASON})"
    return 0
  elif [ "$rc" -eq 0 ]; then
    LAST_STATUS="PASS"
    echo "== $gate: PASS"
  else
    LAST_STATUS="FAIL"
    echo "== $gate: FAIL"
  fi
  return "$rc"
}

[ "$#" -ge 1 ] || { echo "usage: scripts/check <gate> [...]  (lint test perf lock leak fuzz audit secrets workflows sbom build fips all report)" >&2; exit 2; }

failed=0
for arg in "$@"; do
  if [ "$arg" = "report" ]; then
    gate_report || failed=1
  elif [ "$arg" = "all" ]; then
    for g in lint test perf lock audit secrets workflows sbom build; do
      run_gate "$g" || failed=1
    done
  else
    run_gate "$arg" || exit $?
  fi
done
exit "$failed"
